    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ systemInstruction: { parts: [ { text: \"You are a sales assistant. Given a lead's name, company, and message, decide if they are a qualified potential customer, give a score from 1 to 10, and draft a short 2 to 3 sentence warm personalized email reply that answers their question and invites a next step. Respond with only a valid JSON object with exactly three fields: qualified (true or false), score (a number from 1 to 10), and reply_email_body (a string). Do not include any text outside the JSON object.\" } ] }, contents: [ { role: \"user\", parts: [ { text: \"Name: \" + $json.lead_name + \". Company: \" + $json.lead_company + \". Message: \" + $json.lead_message } ] } ], generationConfig: { temperature: 0.4 } }) }}",
        "options": {}
      },
