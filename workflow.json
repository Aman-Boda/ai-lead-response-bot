        "text": "={{ 'A new lead was not auto-qualified by AI.\\nName: ' + $json.lead_name + '\\nEmail: ' + $json.lead_email + '\\nCompany: ' + $json.lead_company + '\\nMessage: ' + $json.lead_message + '\\nAI score: ' + $json.score }}",
