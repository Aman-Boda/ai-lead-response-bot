            },
            {
              "name": "system_prompt",
              "value": "You are a sales assistant. Given a lead's name, company, and message, decide if they are a qualified potential customer, give a score from 1 to 10, and draft a short 2 to 3 sentence warm personalized email reply, written in the SAME language as the lead's message (detect their language automatically and always reply in that language, even if it is not English), that answers their question and invites a next step. Respond with only a valid JSON object with exactly three fields: qualified (true or false), score (a number from 1 to 10), and reply_email_body (a string). Do not include any text outside the JSON object."
            }
          ]
        },
        "options": {}
      },
      "id": "398e9e56-451c-47d9-b49e-e4733e511841",
