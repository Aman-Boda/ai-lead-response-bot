    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const staticData = $getWorkflowStaticData('global');\n  if (!staticData.recentLeads) staticData.recentLeads = {};\n\n  const email = item.json.lead_email;\n  const now = Date.now();\n  const windowMs = 5 * 60 * 1000; // 5 minutes\n\n  for (const key in staticData.recentLeads) {\n    if (now - staticData.recentLeads[key] > windowMs) {\n      delete staticData.recentLeads[key];\n    }\n  }\n\n  const isDuplicateBool = staticData.recentLeads[email] !== undefined;\n\n  if (!isDuplicateBool) {\n    staticData.recentLeads[email] = now;\n  }\n\n  return { json: { ...item.json, isDuplicate: isDuplicateBool ? \"true\" : \"false\" } };\n});"
      },
