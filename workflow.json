    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const systemPrompt = \"You are a sales assistant. Given a lead's name, company, and message, decide if they are a qualified potential customer, give a score from 1 to 10, and draft a short 2 to 3 sentence warm personalized email reply, written in the SAME language as the lead's message (detect their language automatically and always reply in that language, even if it is not English), that answers their question and invites a next step. Respond with only a valid JSON object with exactly three fields: qualified (true or false), score (a number from 1 to 10), and reply_email_body (a string). Do not include any text outside the JSON object.\";\n\n  const userText = \"Name: \" + item.json.lead_name + \". Company: \" + item.json.lead_company + \". Message: \" + item.json.lead_message;\n\n  const requestBody = {\n    systemInstruction: { parts: [ { text: systemPrompt } ] },\n    contents: [ { role: \"user\", parts: [ { text: userText } ] } ],\n    generationConfig: { temperature: 0.4 }\n  };\n\n  return { json: { ...item.json, gemini_request_body: requestBody } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
