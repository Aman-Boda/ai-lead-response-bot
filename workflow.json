    {
      "parameters": {
        "jsCode": "const leadItems = $('Normalize Lead Data').all();\nreturn items.map((item, i) => {\n  const lead = leadItems[i] ? leadItems[i].json : {};\n  let parsed;\n  try {\n    parsed = JSON.parse(item.json.candidates[0].content.parts[0].text);\n  } catch (e) {\n    parsed = { qualified: false, score: 0, reply_email_body: 'Could not parse AI response.' };\n  }\n  return {\n    json: {\n      lead_name: lead.lead_name,\n      lead_email: lead.lead_email,\n      lead_company: lead.lead_company,\n      lead_message: lead.lead_message,\n      qualified: parsed.qualified,\n      score: parsed.score,\n      reply_email_body: parsed.reply_email_body\n    }\n  };\n});"
      },
